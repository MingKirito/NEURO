; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FYP-Neuro"
run/main_scene="uid://dif8dr8c28g4i"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://arts/icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Transition="*res://scenes/Transition.tscn"
MusicController="*res://scenes/MusicController.tscn"
GameManager="*res://scripts/GameManager.gd"
DamageNumbers="*res://scripts/DamageNumbers.gd"
PauseMenu="*res://scenes/pause_menu.tscn"

[dialogue_manager]

runtime/balloon_path="res://dialogue/balloon.tscn"

[display]

window/main_scene="uid://b3vl67lc83svq"

[editor_plugins]

enabled=PackedStringArray("res://addons/ai_assistant_hub/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

